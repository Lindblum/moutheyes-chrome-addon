{
  "name": "moutheyes",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome/Brave extension that puts each face's own mouth over its eyes, in videos in real time and in the pictures on pages.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test-page": "npx --yes http-server test -p 8080 -c-1",
    "fetch-test-media": "node scripts/fetch-test-media.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "gifenc": "^1.0.3"
  }
}
